---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpediaWidget from '../../components/ExpediaWidget.astro';

// TODO: When Booking.com affiliate approved, append &aid=YOUR_ID to each bookingUrl
const hotels = [
  {
    area: 'Galle & Surrounds',
    name: 'Frangipani Tree',
    type: 'Boutique',
    priceRange: 'USD 80–150/night',
    image: '/images/galle-fort.webp',
    highlight: 'A small boutique hotel inside the walls of Galle Fort — one of the few places where you can step out of your door and walk the ramparts within minutes. Colonial architecture, antique furnishings and a quiet courtyard. Galle Fort is one of the best-preserved Dutch colonial fortresses in Asia and staying inside it rather than outside makes a significant difference to the experience.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Frangipani+Tree+Galle+Sri+Lanka',
    tag: '🏰 Inside the Fort',
  },
  {
    area: 'Galle & Surrounds',
    name: 'The Fortress Resort & Spa',
    type: 'Luxury',
    priceRange: 'USD 200–380/night',
    highlight: 'One of the most awarded hotels on the south coast — a luxury clifftop resort near Koggala with a spectacular infinity pool cantilevered over the Indian Ocean. The backdrop of traditional stilt fishermen in the water below has made this pool one of the most photographed in Sri Lanka. About 10 minutes from Galle Fort by car.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=The+Fortress+Resort+Spa+Koggala+Sri+Lanka',
    image: '/images/galle-fort.webp',
    tag: '🏆 Iconic Pool',
  },
  {
    area: 'Mirissa & Weligama',
    name: 'Mirissa Hills',
    type: 'Boutique',
    priceRange: 'USD 70–130/night',
    image: '/images/mirissa-beach.webp',
    highlight: 'A boutique hillside property above Mirissa Bay with one of the most dramatic ocean views on the south coast — a wide panorama over the bay from a hilltop infinity pool. Small, intimate, and genuinely beautiful. Mirissa is Sri Lanka\'s most popular whale watching departure point (November–April) and Mirissa Hills puts you right above the beach.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Mirissa+Hills+Sri+Lanka',
    tag: '🌊 Ocean Panorama',
  },
  {
    area: 'Mirissa & Weligama',
    name: 'Cape Weligama',
    type: 'Luxury',
    priceRange: 'USD 350–700/night',
    image: '/images/weligama.webp',
    highlight: 'Perched on a private headland between Weligama and Mirissa, Cape Weligama is the most dramatically positioned luxury hotel on the south coast — 40 villas cascading down a cliff face to the Indian Ocean. The views are extraordinary at any time of day. An all-inclusive property with multiple pools, a spa and direct access to a sheltered cove. One of Sri Lanka\'s top five hotels by any measure.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Cape+Weligama+Sri+Lanka',
    tag: '💎 Most Dramatic',
  },
  {
    area: 'Mirissa & Weligama',
    name: 'Hiriketiya Surf House',
    type: 'Mid-Range',
    priceRange: 'USD 40–90/night',
    image: '/images/hiriketiya.webp',
    highlight: 'The go-to accommodation hub for the Hiriketiya bay surf scene — a sheltered horseshoe bay that has become one of Sri Lanka\'s most photogenic beach spots. Surf House is informal, social and well-located for both the break and the beach cafes. The right choice if you\'re here for waves and beach life rather than hotel amenities.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Hiriketiya+Surf+House+Sri+Lanka',
    tag: '🏄 Surf Scene',
  },
  {
    area: 'Tangalle',
    name: 'Anantara Peace Haven Tangalle',
    type: 'Luxury',
    priceRange: 'USD 280–500/night',
    image: '/images/tangalle.webp',
    highlight: 'A large luxury beach resort on one of the south coast\'s most beautiful stretches of coastline — a long, quiet beach backed by coconut palms near Tangalle. Part of the Anantara group, with multiple pools, a spa, water sports and consistently high service standards. The beach here is calm enough for swimming, unlike the rougher sections further west.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Anantara+Peace+Haven+Tangalle+Sri+Lanka',
    tag: '🏖️ Beach Resort',
  },
  {
    area: 'Tangalle',
    name: 'Amanwella',
    type: 'Ultra-Luxury',
    priceRange: 'USD 700–1,400/night',
    image: '/images/tangalle.webp',
    highlight: 'The finest hotel in Sri Lanka by most measures — an Aman property set on a private cove near Tangalle with just 30 suites, each with a private pool and direct ocean views. Aman properties are known for what they don\'t have: no crowds, no corporate noise, no visible service. If you\'re celebrating something significant and budget is not the constraint, Amanwella is the answer.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Amanwella+Tangalle+Sri+Lanka',
    tag: '✨ Most Exclusive',
  },
  {
    area: 'Tangalle',
    name: 'Buckingham Place',
    type: 'Mid-Luxury',
    priceRange: 'USD 120–220/night',
    image: '/images/tangalle.webp',
    highlight: 'A well-regarded boutique property near Tangalle with a strong design sensibility and beautiful beachfront location. Smaller and more personal than the Anantara, with a loyal following among repeat visitors to Sri Lanka. Good value for the south coast luxury tier and consistently well-reviewed for service.',
    bookingUrl: 'https://www.booking.com/searchresults.html?ss=Buckingham+Place+Tangalle+Sri+Lanka',
    tag: '🌴 Boutique Beachfront',
  },
];

const areas = ['Galle & Surrounds', 'Mirissa & Weligama', 'Tangalle'];

const carouselImages = [
  { src: '/images/mirissa-beach.webp', alt: 'Mirissa beach south coast Sri Lanka' },
  { src: '/images/galle-fort.webp', alt: 'Galle Fort Sri Lanka' },
  { src: '/images/weligama.webp', alt: 'Weligama bay Sri Lanka' },
  { src: '/images/hiriketiya.webp', alt: 'Hiriketiya bay Sri Lanka' },
  { src: '/images/tangalle.webp', alt: 'Tangalle beach Sri Lanka' },
];

const typeColors: Record<string, string> = {
  'Ultra-Luxury': 'bg-ceylon-gold-200 text-ceylon-gold-900',
  'Luxury': 'bg-ceylon-gold-100 text-ceylon-gold-800',
  'Mid-Luxury': 'bg-ceylon-green-100 text-ceylon-green-800',
  'Boutique': 'bg-purple-100 text-purple-800',
  'Mid-Range': 'bg-blue-100 text-blue-800',
};
---
<BaseLayout title="Best Hotels on Sri Lanka's South Coast (2026) | The Trails of Ceylon" description="Hand-picked hotels on Sri Lanka's south coast — Galle Fort boutiques, Weligama cliff-top luxury, Mirissa ocean-view stays and Tangalle beach resorts." type="article" publishDate="2026-09-13">

  <div class="relative h-[55vh] min-h-[380px] overflow-hidden">
    <img src="/images/mirissa-beach.webp" alt="Mirissa beach south coast Sri Lanka" class="w-full h-full object-cover" fetchpriority="high" width="800" height="600" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/20 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-8">
      <div class="max-w-4xl mx-auto">
        <nav class="flex items-center gap-2 text-white/70 text-xs mb-3" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white">Home</a><span>/</span><a href="/guides" class="hover:text-white">Travel Guides</a><span>/</span><span class="text-white">South Coast Hotels</span>
        </nav>
        <span class="inline-block bg-ceylon-gold-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide mb-3">Accommodation</span>
        <h1 class="font-serif font-black text-white text-4xl sm:text-5xl mb-2">Best Hotels on Sri Lanka's South Coast</h1>
        <p class="text-white/80 text-sm">8 hand-picked stays from Galle to Tangalle</p>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <p class="text-xs text-gray-400 mb-6 flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      Last Updated: September 2026
    </p>

    <p class="text-gray-700 text-lg leading-relaxed mb-10">The south coast runs from Galle in the west to Tangalle in the east — about 100km of coastline that ranges from the cobblestone lanes of a Dutch colonial fort to cliff-hanging luxury villas, Instagram-famous bays and some of the most secluded beaches in the country. The best season is November to April, when the southwest monsoon has cleared and the sea is calm. These are the places worth staying.</p>

    <!-- Photo Carousel -->
    <div class="relative mb-14 rounded-2xl overflow-hidden" id="carousel">
      <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out">
        {carouselImages.map((img) => (
          <div class="min-w-full aspect-[16/7]">
            <img src={img.src} alt={img.alt} class="w-full h-full object-cover" loading="lazy" width="800" height="350" />
          </div>
        ))}
      </div>
      <button id="carousel-prev" aria-label="Previous image" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-black/50 hover:bg-black/70 text-white rounded-full flex items-center justify-center transition-colors z-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button id="carousel-next" aria-label="Next image" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-black/50 hover:bg-black/70 text-white rounded-full flex items-center justify-center transition-colors z-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
      <div id="carousel-dots" class="absolute bottom-3 left-0 right-0 flex justify-center gap-1.5 z-10">
        {carouselImages.map((_, i) => (
          <button data-index={i} class={`carousel-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-white/40'}`} aria-label={`Go to image ${i + 1}`}></button>
        ))}
      </div>
    </div>

    <!-- Hotels by area -->
    {areas.map(area => (
      <div class="mb-16">
        <h2 class="font-serif font-black text-gray-900 text-3xl mb-6 pb-3 border-b-2 border-ceylon-gold-200">{area}</h2>
        <div class="space-y-5">
          {hotels.filter(h => h.area === area).map(hotel => (
            <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <div class="sm:flex">
                <div class="sm:w-48 sm:flex-shrink-0 h-44 sm:h-auto overflow-hidden">
                  <img src={hotel.image} alt={hotel.name} class="w-full h-full object-cover" loading="lazy" width="192" height="176" />
                </div>
                <div class="p-5 flex flex-col flex-1">
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                    <div>
                      <h3 class="font-serif font-bold text-gray-900 text-lg">{hotel.name}</h3>
                      <div class="flex flex-wrap gap-1.5 mt-1.5">
                        <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${typeColors[hotel.type]}`}>{hotel.type}</span>
                        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">{hotel.tag}</span>
                      </div>
                    </div>
                    <span class="text-sm font-bold text-ceylon-green-700 whitespace-nowrap">{hotel.priceRange}</span>
                  </div>
                  <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-1">{hotel.highlight}</p>
                  <a
                    href={hotel.bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    class="self-start inline-flex items-center gap-2 bg-ceylon-green-700 hover:bg-ceylon-green-800 text-white font-semibold px-4 py-2 rounded-xl text-sm transition-colors"
                  >
                    Check Prices
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="bg-gradient-to-br from-ceylon-gold-50 to-ceylon-green-50 border border-ceylon-gold-200 rounded-2xl p-6 mt-4 mb-6">
      <h3 class="font-serif font-bold text-gray-900 text-lg mb-3">Tips for Booking South Coast Accommodation</h3>
      <ul class="text-sm text-gray-600 space-y-2 leading-relaxed list-none p-0 m-0">
        <li><strong>Best season is November to April.</strong> The southwest monsoon affects the south coast from May to October — seas are rough and many beach hotels close or reduce services. Peak season is December–January and March–April; book at least 6 weeks ahead.</li>
        <li><strong>Galle Fort stays book up fast.</strong> There are very few hotels actually inside the fort walls — the best ones sell out months ahead. Book early or you'll end up staying outside the fort.</li>
        <li><strong>Weligama and Mirissa are different vibes.</strong> Weligama is calmer, more upmarket; Mirissa is livelier with a younger crowd and the whale watching boats. Choose based on what you want from the trip.</li>
        <li><strong>Tangalle is worth the extra drive.</strong> Most tourists turn around at Mirissa or Weligama — Tangalle is quieter, the beaches are better, and the hotels (Anantara, Amanwella) are some of the finest in the country.</li>
      </ul>
    </div>

    <p class="text-xs text-gray-400 mt-4">Prices are approximate and vary by season. We may earn a small commission if you book via links on this page, at no extra cost to you.</p>
  </div>

  <ExpediaWidget heading="🏨 Search South Coast Hotels" />
</BaseLayout>

<script>
  const track = document.getElementById('carousel-track') as HTMLElement;
  const dots = document.querySelectorAll('.carousel-dot') as NodeListOf<HTMLButtonElement>;
  const total = dots.length;
  let current = 0;

  function goTo(index: number) {
    current = (index + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => {
      d.classList.toggle('bg-white', i === current);
      d.classList.toggle('bg-white/40', i !== current);
    });
  }

  document.getElementById('carousel-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('carousel-next')?.addEventListener('click', () => goTo(current + 1));
  dots.forEach(dot => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));

  setInterval(() => goTo(current + 1), 4000);
</script>
