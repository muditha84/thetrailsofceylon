const typeColors: Record<string, string> = {
  Place:    'bg-ceylon-green-100 text-ceylon-green-800',
  Activity: 'bg-amber-100 text-amber-800',
  Guide:    'bg-blue-100 text-blue-800',
  Blog:     'bg-purple-100 text-purple-800',
};

const input   = document.getElementById('site-search') as HTMLInputElement;
const results = document.getElementById('search-results') as HTMLDivElement;
const clear   = document.getElementById('search-clear') as HTMLSpanElement;
const wrapper = document.getElementById('search-wrapper') as HTMLDivElement;

function doSearch(q: string) {
  const query = q.toLowerCase().trim();
  if (query.length < 2) { hide(); return; }
  const matches = searchIndex.filter(item =>
    (item.t + ' ' + item.k).toLowerCase().includes(query)
  ).slice(0, 7);
  if (!matches.length) {
    results.innerHTML = `<div class="px-5 py-4 text-sm text-gray-400 text-center">No results for "${q}"</div>`;
  } else {
    results.innerHTML = matches.map(m => `
      <a href="${m.h}" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors border-b border-gray-50 last:border-0 group">
        <div class="flex-1 min-w-0">
          <div class="font-semibold text-gray-900 text-sm truncate group-hover:text-ceylon-green-700">${m.t}</div>
        </div>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full flex-shrink-0 ${typeColors[m.c] ?? 'bg-gray-100 text-gray-600'}">${m.c}</span>
        <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    `).join('');
  }
  results.classList.remove('hidden');
}

function hide() { results.classList.add('hidden'); }

input?.addEventListener('input', () => {
  const q = input.value;
  clear.classList.toggle('hidden', !q);
  doSearch(q);
});

input?.addEventListener('keydown', (e: KeyboardEvent) => {
  if (e.key === 'Escape') { input.value = ''; clear.classList.add('hidden'); hide(); }
  if (e.key === 'Enter') {
    const first = results.querySelector('a') as HTMLAnchorElement;
    if (first) window.location.href = first.getAttribute('href')!;
  }
});

clear?.addEventListener('click', () => { input.value = ''; clear.classList.add('hidden'); hide(); input.focus(); });

document.addEventListener('click', (e) => {
  if (!wrapper?.contains(e.target as Node)) hide();
});
</script>
