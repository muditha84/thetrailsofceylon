---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardDestination from '../components/CardDestination.astro';
import CardBlog from '../components/CardBlog.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExpediaWidget from '../components/ExpediaWidget.astro';

const destinations = [
  {
    href: '/places/sigiriya',
    image: '/images/sigiriya.webp',
    title: 'Sigiriya Rock Fortress',
    subtitle: 'Cultural Triangle',
    tag: 'Must Visit',
    description: 'Climb an ancient rock fortress rising 200m above the jungle floor, adorned with 5th-century frescoes.',
  },
  {
    href: '/places/ella',
    image: '/images/ella.webp',
    title: 'Ella',
    subtitle: 'Hill Country',
    tag: 'Trending',
    description: 'A misty mountain village surrounded by emerald tea plantations and dramatic waterfalls.',
  },
  {
    href: '/places/galle',
    image: '/images/galle-fort.webp',
    title: 'Galle Fort',
    subtitle: 'Southern Coast',
    tag: null,
    description: 'A UNESCO World Heritage Dutch colonial fort with cobblestone streets, boutiques and ocean views.',
  },
  {
    href: '/places/kandy',
    image: '/images/kandy.webp',
    title: 'Kandy',
    subtitle: 'Hill Capital',
    tag: null,
    description: 'The cultural heartland of Sri Lanka, home to the sacred Temple of the Tooth Relic.',
  },
  {
    href: '/places/yala',
    image: '/images/yala.webp',
    title: 'Yala National Park',
    subtitle: 'Wildlife',
    tag: null,
    description: "Sri Lanka's most popular safari destination with the world's highest density of leopards.",
  },
  {
    href: '/places/mirissa',
    image: '/images/mirissa-beach.webp',
    title: 'Mirissa Beach',
    subtitle: 'Southern Coast',
    tag: null,
    description: 'A crescent of golden sand — perfect for swimming, whale watching and watching the sunset.',
  },
];

const activities = [
  {
    href: '/things-to-do/whale-watching',
    image: '/images/whale-watching.webp',
    title: 'Whale Watching',
    subtitle: 'Ocean Experience',
    tag: 'Popular',
    description: 'Spot blue whales — the largest animals on earth — just off the southern coast of Sri Lanka.',
  },
  {
    href: '/things-to-do/tea-plantation-tours',
    image: '/images/tea-plantation.webp',
    title: 'Tea Plantation Tours',
    subtitle: 'Hill Country',
    tag: null,
    description: 'Walk through endless green terraces and learn how Ceylon tea is grown and processed.',
  },
  {
    href: '/things-to-do/train-rides',
    image: '/images/scenic-train.webp',
    title: 'Scenic Train Rides',
    subtitle: 'Highland Railways',
    tag: null,
    description: "Ride one of the world's most beautiful train journeys from Kandy to Ella through cloud-wreathed mountains.",
  },
  {
    href: '/things-to-do/wildlife-safaris',
    image: '/images/yala.webp',
    title: 'Wildlife Safaris',
    subtitle: 'National Parks',
    tag: null,
    description: 'Track leopards, elephants and crocodiles in Yala, Udawalawe and Minneriya national parks.',
  },
  {
    href: '/things-to-do/hiking',
    image: '/images/adams-peak.webp',
    title: 'Hiking',
    subtitle: 'Trails & Trekking',
    tag: null,
    description: "Climb Adam's Peak, Ella Rock and Horton Plains through breathtaking scenery.",
  },
  {
    href: '/things-to-do/surfing',
    image: '/images/arugam-bay.webp',
    title: 'Surfing',
    subtitle: 'East & South Coast',
    tag: null,
    description: 'World-class breaks at Arugam Bay, Weligama and Hikkaduwa for all skill levels.',
  },
];

const blogPosts = [
  {
    href: '/blog/2-weeks-in-sri-lanka-itinerary',
    image: '/images/scenic-train.webp',
    title: 'The Perfect 2-Week Sri Lanka Itinerary',
    category: 'Itineraries',
    date: 'April 10, 2026',
    readTime: '12 min',
    excerpt: 'From ancient ruins to pristine beaches — the ultimate two-week route to see the best of Sri Lanka.',
  },
  {
    href: '/blog/best-beaches-sri-lanka',
    image: '/images/mirissa-beach.webp',
    title: "Sri Lanka's 10 Best Beaches: A Complete Guide",
    category: 'Beaches',
    date: 'March 28, 2026',
    readTime: '8 min',
    excerpt: "From surfers' paradise to hidden coves — discover Sri Lanka's most beautiful beaches for every type of traveller.",
  },
  {
    href: '/blog/sri-lanka-budget-travel',
    image: '/images/colombo.webp',
    title: 'Sri Lanka on a Budget: How to Travel Cheap',
    category: 'Budget Travel',
    date: 'March 15, 2026',
    readTime: '10 min',
    excerpt: 'Everything you need to know to visit Sri Lanka without breaking the bank — accommodation, food, transport and more.',
  },
  {
    href: '/blog/sigiriya-rock-fortress-guide',
    image: '/images/sigiriya.webp',
    title: 'Sigiriya Rock Fortress: The Complete Visitor Guide',
    category: 'Cultural Sites',
    date: 'March 5, 2026',
    readTime: '9 min',
    excerpt: 'Everything you need to know before climbing the iconic Lion Rock — tickets, timing, frescoes, and how to avoid the crowds.',
  },
  {
    href: '/blog/ella-travel-guide',
    image: '/images/ella.webp',
    title: 'Ella Travel Guide: The Best of Sri Lanka\'s Hill Country Village',
    category: 'Destinations',
    date: 'February 20, 2026',
    readTime: '10 min',
    excerpt: 'Ella in a nutshell: Nine Arch Bridge at dawn, Ella Rock hike, Little Adam\'s Peak and the best cafés in the hills.',
  },
  {
    href: '/blog/sri-lanka-food-guide',
    image: '/images/cooking-classes.webp',
    title: 'Sri Lankan Food: What to Eat & Where',
    category: 'Food & Drink',
    date: 'February 22, 2026',
    readTime: '9 min',
    excerpt: 'A delicious guide to Sri Lankan cuisine — from coconut sambol to hoppers, rice and curry to kottu roti.',
  },
];
---

<BaseLayout
  title="The Trails of Ceylon | Sri Lanka Travel Guide"
  description="Your expert guide to travelling Sri Lanka. Discover the best places to visit, things to do, travel tips and itineraries for the wonder island of Ceylon."
>

  <!-- Hero Section -->
  {(() => {
    const slides = [
      { img: '/images/heroes/hero-beach.webp',     alt: 'Golden beaches of Sri Lanka',                label: 'Golden Beaches'      },
      { img: '/images/heroes/hero-hills.webp',     alt: 'Misty hill country tea estates',             label: 'Misty Hill Country'  },
      { img: '/images/heroes/hero-wildlife.webp',  alt: 'Leopard in Yala National Park',              label: 'Incredible Wildlife' },
      { img: '/images/heroes/hero-sigiriya.webp',  alt: 'Sigiriya rock fortress Sri Lanka',           label: 'Ancient Wonders'     },
      { img: '/images/heroes/hero-train.webp',     alt: 'Scenic highland railway Sri Lanka',          label: 'Scenic Journeys'     },
      { img: '/images/heroes/hero-galle.webp',     alt: 'Galle Fort colonial heritage',               label: 'Colonial Heritage'   },
      { img: '/images/heroes/hero-food.webp',      alt: 'Sri Lankan cuisine and spices',              label: 'Incredible Cuisine'  },
      { img: '/images/heroes/hero-whale.webp',     alt: 'Blue whale off Mirissa Sri Lanka',           label: 'Ocean Adventures'    },
      { img: '/images/heroes/hero-adventure.webp', alt: 'White-water rafting Kitulgala Sri Lanka',    label: 'Thrilling Adventures'},
      { img: '/images/heroes/hero-temple.webp',    alt: 'Sacred Buddhist temple Sri Lanka',           label: 'Sacred Temples'      },
    ];
    return (
      <section class="relative min-h-screen flex items-center overflow-hidden" id="hero-section">
        <div class="absolute inset-0 z-0" id="hero-slideshow">
          {slides.map((slide, i) => (
            <img
              src={slide.img}
              alt={slide.alt}
              class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
              data-slide={i}
              fetchpriority={i === 0 ? 'high' : undefined}
              loading={i === 0 ? 'eager' : 'lazy'}
              width="1920"
              height="1080"
            />
          ))}
          <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-black/20 pointer-events-none"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>

          <!-- Slide label -->
          <div class="absolute top-6 right-6 z-20 hidden sm:block">
            <span id="hero-label" class="text-white/70 text-xs font-medium tracking-widest uppercase bg-black/20 backdrop-blur-sm px-3 py-1.5 rounded-full transition-opacity duration-500">
              {slides[0].label}
            </span>
          </div>

          <!-- Dot indicators -->
          <div class="absolute bottom-20 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
            {slides.map((_, i) => (
              <button
                class={`rounded-full transition-all duration-300 ${i === 0 ? 'bg-white w-6 h-2' : 'bg-white/50 w-2 h-2 hover:bg-white/80'}`}
                data-dot={i}
                aria-label={`Go to slide ${i + 1}`}
              />
            ))}
          </div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 mb-6">
              <span class="w-2 h-2 rounded-full bg-ceylon-gold-400 animate-pulse"></span>
              <span class="text-white/90 text-xs font-medium tracking-wide uppercase">Sri Lanka Travel Guide</span>
            </div>
            <h1 class="font-serif font-black text-5xl sm:text-6xl lg:text-7xl text-white leading-[1.05] text-balance">
              Discover the<br/>
              <span class="text-ceylon-gold-400">Wonder Island</span><br/>
              of Ceylon
            </h1>
            <p class="mt-6 text-lg sm:text-xl text-white/85 leading-relaxed max-w-xl">
              Ancient ruins, misty highlands, golden beaches and incredible wildlife — Sri Lanka is the world's most rewarding island destination.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4">
              <a href="/guides/sri-lanka-itinerary-2-weeks" class="inline-flex items-center justify-center gap-2 bg-ceylon-gold-500 hover:bg-ceylon-gold-400 text-white font-bold px-7 py-4 rounded-full text-base transition-all duration-200 hover:shadow-lg hover:shadow-ceylon-gold-500/30">
                Start Planning Your Trip
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a href="/places" class="inline-flex items-center justify-center gap-2 bg-white/15 hover:bg-white/25 backdrop-blur-sm border border-white/30 text-white font-semibold px-7 py-4 rounded-full text-base transition-all duration-200">
                Explore Destinations
              </a>
            </div>

            <!-- Site Search -->
            <div class="mt-6 relative max-w-lg" id="search-wrapper">
              <div class="flex items-center gap-3 bg-white/15 hover:bg-white/20 backdrop-blur-md border border-white/30 rounded-2xl px-4 py-3.5 transition-colors focus-within:bg-white/25 focus-within:border-white/50">
                <svg class="w-5 h-5 text-white/70 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input
                  type="text"
                  id="site-search"
                  placeholder="Search destinations, activities &amp; guides…"
                  autocomplete="off"
                  class="flex-1 bg-transparent text-white placeholder:text-white/55 outline-none text-sm min-w-0"
                />
                <span id="search-clear" class="hidden cursor-pointer text-white/50 hover:text-white text-lg leading-none select-none">✕</span>
              </div>
              <div id="search-results" class="hidden absolute top-full mt-2 left-0 right-0 bg-white rounded-2xl shadow-2xl overflow-hidden z-50 max-h-[22rem] overflow-y-auto border border-gray-100"></div>
            </div>
          </div>
        </div>

        <!-- Stats bar -->
        <div class="absolute bottom-0 left-0 right-0 z-10 bg-black/30 backdrop-blur-sm border-t border-white/10">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-4 divide-x divide-white/20 py-4">
              {[
                { value: '35+', label: 'Destinations' },
                { value: '25+', label: 'Guides & Activities' },
                { value: 'Growing', label: 'Community' },
                { value: '8', label: 'UNESCO Sites' },
              ].map(stat => (
                <div class="text-center px-4">
                  <div class="font-serif font-bold text-white text-xl sm:text-2xl">{stat.value}</div>
                  <div class="text-white/60 text-xs">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    );
  })()}

  <!-- Quick Facts Banner -->
  <section class="bg-ceylon-green-800 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-2">
        {[
          { icon: '🌡️', text: 'Year-round warm weather' },
          { icon: '✈️', text: 'Colombo hub airport' },
          { icon: '🪙', text: 'Budget-friendly' },
          { icon: '🐘', text: 'Wildlife paradise' },
          { icon: '🌊', text: '1,340km of coastline' },
          { icon: '🏛️', text: '8 UNESCO World Heritage Sites' },
        ].map(fact => (
          <div class="flex items-center gap-2 text-ceylon-green-200 text-sm">
            <span>{fact.icon}</span>
            <span>{fact.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Top Destinations -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <SectionHeader
          eyebrow="Places to Visit"
          title="Sri Lanka's Most Iconic Destinations"
          subtitle="From ancient rock fortresses to tropical beaches — explore the landmarks that define this extraordinary island."
        />
        <a href="/places" class="hidden md:inline-flex items-center gap-2 text-ceylon-green-700 font-semibold text-sm hover:gap-3 transition-all">
          All destinations
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {destinations.map(dest => (
          <CardDestination {...dest} />
        ))}
      </div>
      <div class="text-center mt-10 md:hidden">
        <a href="/places" class="inline-flex items-center gap-2 border-2 border-ceylon-green-700 text-ceylon-green-700 font-semibold px-6 py-3 rounded-full hover:bg-ceylon-green-700 hover:text-white transition-colors">
          View All Destinations
        </a>
      </div>
    </div>
  </section>

  <!-- Region Selector -->
  <section class="py-20 bg-ceylon-green-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Explore by Region"
        title="Where Do You Want to Go?"
        subtitle="Sri Lanka packs incredible diversity into a small island. Find the perfect region for your travel style."
        centered
      />
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-12">
        <a href="/places/cultural-triangle" class="flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 bg-amber-50 border-amber-200 hover:bg-amber-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 10v11M12 10v11M16 10v11"/></svg>
          <span class="font-semibold text-gray-800 text-sm">Cultural Triangle</span>
        </a>
        <a href="/places/hill-country" class="flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 bg-ceylon-green-50 border-ceylon-green-200 hover:bg-ceylon-green-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><path d="M8 3l4 8 5-5 5 15H2L8 3z"/></svg>
          <span class="font-semibold text-gray-800 text-sm">Hill Country</span>
        </a>
        <a href="/places/south-coast" class="flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 bg-blue-50 border-blue-200 hover:bg-blue-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2"/></svg>
          <span class="font-semibold text-gray-800 text-sm">South Coast</span>
        </a>
        <a href="/places/east-coast" class="flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 bg-cyan-50 border-cyan-200 hover:bg-cyan-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0891b2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <span class="font-semibold text-gray-800 text-sm">East Coast</span>
        </a>
        <a href="/places/north-jaffna" class="flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 bg-purple-50 border-purple-200 hover:bg-purple-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
          <span class="font-semibold text-gray-800 text-sm">North & Jaffna</span>
        </a>
        <a href="/places/wildlife-parks" class="flex flex-col items-center text-center p-5 rounded-2xl border-2 transition-all duration-200 hover:-translate-y-1 bg-orange-50 border-orange-200 hover:bg-orange-100">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="4" cy="8" r="2"/><circle cx="6.5" cy="15.5" r="2"/><path d="M12 17.5c0 0-3.5-4-6-4s-3 3-1.5 5 4.5 3.5 7.5 3.5 6-1.5 7.5-3.5S18 13.5 15 13.5s-3 4-3 4z"/></svg>
          <span class="font-semibold text-gray-800 text-sm">Wildlife Parks</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Things to Do -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <SectionHeader
          eyebrow="Things to Do"
          title="Unforgettable Experiences in Sri Lanka"
          subtitle="From whale watching to ancient train rides — Sri Lanka offers experiences like nowhere else on earth."
        />
        <a href="/things-to-do" class="hidden md:inline-flex items-center gap-2 text-ceylon-green-700 font-semibold text-sm hover:gap-3 transition-all">
          All activities
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {activities.map(act => (
          <CardDestination {...act} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Sri Lanka -->
  <section class="py-20 bg-ceylon-green-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25">
      <img
        src="/images/heroes/hero-wildlife.webp"
        alt=""
        class="w-full h-full object-cover object-center"
        loading="lazy"
        width="1920"
        height="1080"
        style="object-fit:cover;"
      />
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Why Sri Lanka"
        title="The World's Best-Kept Secret"
        subtitle="Voted the #1 travel destination in the world, Sri Lanka packs the diversity of an entire continent into an island you can cross in a day."
        light
        centered
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-14">
        {[
          { icon: '🦁', title: 'Epic Wildlife',   body: 'Leopards, elephants, blue whales and 400+ species of birds — all in a tiny island.' },
          { icon: '🌿', title: 'Ancient Culture', body: '2,500 years of history, 8 UNESCO sites and some of the world\'s oldest Buddhist traditions.' },
          { icon: '🍛', title: 'Incredible Food', body: 'Sri Lankan cuisine is among the world\'s most aromatic — coconut curries, hoppers and fresh seafood.' },
          { icon: '💰', title: 'Great Value',     body: 'World-class experiences at a fraction of the cost of other tropical destinations.' },
        ].map(item => (
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-6 hover:bg-white/15 transition-colors">
            <span class="text-4xl">{item.icon}</span>
            <h3 class="font-serif font-bold text-white text-xl mt-3 mb-2">{item.title}</h3>
            <p class="text-ceylon-green-200 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Travel Guides CTA -->
  <section class="py-20 bg-ceylon-gold-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <SectionHeader
            eyebrow="Travel Guides"
            title="Plan the Perfect Sri Lanka Trip"
            subtitle="Expert-written guides to help you plan every aspect of your Sri Lanka adventure — from 1-week sprints to month-long explorations."
          />
          <div class="mt-8 flex flex-col gap-3">
            {[
              { href: '/guides/sri-lanka-itinerary-2-weeks', label: '2-Week Sri Lanka Itinerary' },
              { href: '/guides/best-time-to-visit',          label: 'Best Time to Visit Sri Lanka' },
