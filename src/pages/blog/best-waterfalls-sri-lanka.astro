        <h1 class="font-serif font-black text-white text-4xl sm:text-5xl leading-tight">The Best Waterfalls in Sri Lanka</h1>
        <div class="flex items-center justify-center gap-4 text-white/70 text-sm mt-4">
          <span>June 2025</span><span>·</span><span>8 min read</span>
        </div>
      </div>
