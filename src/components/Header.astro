    { t: '2-Week Sri Lanka Itinerary',      h: '/guides/sri-lanka-itinerary-2-weeks', c: 'Guide', k: 'itinerary 2 weeks two week route plan trip' },
    { t: '1-Week Sri Lanka Itinerary',      h: '/guides/sri-lanka-itinerary-1-week',  c: 'Guide', k: 'itinerary 1 week one week route plan short trip' },
    { t: '1-Month Sri Lanka Itinerary',     h: '/guides/sri-lanka-itinerary-1-month', c: 'Guide', k: 'itinerary 1 month one month long trip route plan' },
    { t: 'Sri Lanka Safety Guide',          h: '/guides/sri-lanka-safety-guide',    c: 'Guide',    k: 'safety safe tips travel health risk scam' },
    { t: 'What to Pack for Sri Lanka',      h: '/guides/what-to-pack-sri-lanka',    c: 'Guide',    k: 'packing list what to bring clothes kit gear luggage' },
    { t: 'Sri Lanka Food Guide',            h: '/guides/sri-lanka-food-guide',      c: 'Guide',    k: 'food guide eat cuisine rice curry hopper kottu' },
  ];

  const typeColors: Record<string, string> = {
    Place:    'bg-ceylon-green-100 text-ceylon-green-800',
    Activity: 'bg-amber-100 text-amber-800',
    Guide:    'bg-blue-100 text-blue-800',
  };

  const modal      = document.getElementById('search-modal') as HTMLDivElement;
  const backdrop   = document.getElementById('search-backdrop') as HTMLDivElement;
  const closeBtn   = document.getElementById('search-modal-close') as HTMLButtonElement;
  const openBtn    = document.getElementById('search-toggle') as HTMLButtonElement;
  const input      = document.getElementById('header-search-input') as HTMLInputElement;
  const results    = document.getElementById('header-search-results') as HTMLDivElement;
  const suggestions = document.getElementById('search-suggestions') as HTMLDivElement;

  function openSearch() {
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 50);
  }

  function closeSearch() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    if (input) { input.value = ''; }
    if (suggestions) suggestions.classList.remove('hidden');
    showEmpty();
  }

  function showEmpty() {
    // Remove result rows but keep suggestions
    Array.from(results.children).forEach(el => {
      if (el.id !== 'search-suggestions') el.remove();
    });
  }

  function doSearch(q: string) {
    const query = q.toLowerCase().trim();
    // Remove old result rows
    Array.from(results.children).forEach(el => {
      if (el.id !== 'search-suggestions') el.remove();
    });

    if (query.length < 2) {
      suggestions?.classList.remove('hidden');
      return;
    }
    suggestions?.classList.add('hidden');

    const matches = searchIndex.filter(item =>
      (item.t + ' ' + item.k).toLowerCase().includes(query)
    ).slice(0, 8);

    const fragment = document.createDocumentFragment();
    if (!matches.length) {
      const el = document.createElement('div');
      el.className = 'px-5 py-8 text-sm text-gray-400 text-center';
      el.textContent = `No results for "${q}"`;
      fragment.appendChild(el);
    } else {
      matches.forEach(m => {
        const a = document.createElement('a');
        a.href = m.h;
        a.className = 'flex items-center gap-3 px-5 py-3.5 hover:bg-gray-50 transition-colors border-b border-gray-50 last:border-0 group';
        a.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-gray-900 text-sm truncate group-hover:text-ceylon-green-700">${m.t}</div>
          </div>
          <span class="text-xs font-medium px-2 py-0.5 rounded-full flex-shrink-0 ${typeColors[m.c] ?? 'bg-gray-100 text-gray-600'}">${m.c}</span>
          <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        `;
        fragment.appendChild(a);
      });
    }
    results.appendChild(fragment);
  }

  openBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  backdrop?.addEventListener('click', closeSearch);

  input?.addEventListener('input', () => doSearch(input.value));
  input?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') { closeSearch(); }
    if (e.key === 'Enter') {
      const first = results.querySelector('a') as HTMLAnchorElement | null;
      if (first) window.location.href = first.getAttribute('href')!;
    }
  });

  // Keyboard shortcut: / or Ctrl+K
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const active = document.activeElement as HTMLElement;
    const typing = active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable;
    if ((e.key === '/' && !typing) || ((e.ctrlKey || e.metaKey) && e.key === 'k')) {
      e.preventDefault();
      openSearch();
    }
  });

  // Popular suggestion chips
  document.querySelectorAll('.search-suggestion').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).textContent?.trim() ?? '';
      if (input) { input.value = text; }
      doSearch(text);
    });
  });
</script>
